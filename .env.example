PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/digital_dark_spot
GEMINI_API_KEY=your_gemini_api_key
FRONTEND_URL=http://localhost:3000

# --- Optional ---
# Separate database used ONLY by the integration tests (npm test). Never use your real database here.
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/digital_dark_spot_test
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=90
GEMINI_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=8192
MAX_CHARS_PER_SOURCE=12000
# Set to a number (e.g. 1) when running behind a reverse proxy so rate limiting sees real client IPs
# TRUST_PROXY=1
# DATABASE_SSL=true
# LOG_LEVEL=info
